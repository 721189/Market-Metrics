# Development image: runs the server from source via tsx with hot reload.
# The production Dockerfile ships only dist/ and cannot do this, so dev gets
# its own image. Used by docker-compose `dev` profile; never pushed.
FROM node:22-alpine

WORKDIR /app

RUN apk add --no-cache dumb-init

COPY package.json package-lock.json tsconfig.json vite.config.ts ./

RUN npm ci --no-audit --no-fund

# Source is bind-mounted by docker-compose, so no COPY of src here.
# index.html + server.ts entry must exist for vite/tsx resolution.
COPY index.html server.ts ./

ENV NODE_ENV=development
ENV PORT=3000

EXPOSE 3000
EXPOSE 24678

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["npx", "tsx", "server.ts"]
