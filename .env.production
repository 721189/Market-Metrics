# =============================================================================
# Production build-time client config (Vite inlines these into the SPA bundle)
# =============================================================================
# Vite loads this file automatically during `vite build` (production mode), so a
# Render/Vercel deploy picks these up with NO dashboard configuration required.
#
# PRECEDENCE: real environment variables (e.g. set in the Render dashboard)
# always OVERRIDE values in this file. So this is a working default for the
# bundled Firebase project; to point a deploy at a DIFFERENT Firebase project,
# set the VITE_FIREBASE_* variables in the host's environment instead of editing
# this file, then redeploy.
#
# SECURITY: these are Firebase WEB config values (not secrets). A web API key
# only identifies the project; data access is enforced by Firestore security
# rules and Firebase Auth. The same values are already public in
# firebase-applet-config.json. Never put a service-account key here.
#
# Source of truth: firebase-applet-config.json
VITE_FIREBASE_API_KEY="AIzaSyBf8gwNxlu7HT2iZrnvPIPL87aiiBdIL2s"
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0526957989.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0526957989"
VITE_FIREBASE_STORAGE_BUCKET="gen-lang-client-0526957989.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="1054744311444"
VITE_FIREBASE_APP_ID="1:1054744311444:web:e97a25066c8c07a1ffe681"
