# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# DEPLOYMENT ENVIRONMENT ISOLATION
# ---------------------------------------------------------------------------
# APP_ENV / NODE_ENV select the environment: development | staging | production.
# An unset or unknown value resolves to "development" — never to production.
#
# development and test fall back to firebase-applet-config.json, so a fresh
# checkout runs with no setup. staging and production MUST supply their own
# identifiers below; boot fails closed when any are missing.
APP_ENV="development"

# The Firebase project that owns this environment's resources.
FIREBASE_PROJECT_ID=""

# Firestore database id (supports multi-database projects).
FIRESTORE_DATABASE_ID=""

# Cloud Storage bucket for raw retrieval artifacts (raw HTML/PDF + normalized text).
STORAGE_BUCKET=""

# Firebase auth domain.
FIREBASE_AUTH_DOMAIN=""

# Where the Gemini credential comes from (descriptive only; never the secret).
# e.g. "env:GEMINI_API_KEY" or "secret-manager:projects/x/secrets/gemini"
GEMINI_CREDENTIAL_SOURCE=""

# The production project id. When set, staging/development are forbidden from
# binding it — this is the guard against testing against production data.
PRODUCTION_PROJECT_ID=""

