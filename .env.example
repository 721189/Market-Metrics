# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# DEPLOYMENT ENVIRONMENT ISOLATION
# ---------------------------------------------------------------------------
# APP_ENV / NODE_ENV select the environment: development | staging | production.
# An unset or unknown value resolves to "development" — never to production.
#
# development and test fall back to firebase-applet-config.json, so a fresh
# checkout runs with no setup. staging and production MUST supply their own
# identifiers below; boot fails closed when any are missing.
APP_ENV="development"

# The Firebase project that owns this environment's resources.
FIREBASE_PROJECT_ID=""

# Firestore database id (supports multi-database projects).
FIRESTORE_DATABASE_ID=""

# Cloud Storage bucket for raw retrieval artifacts (raw HTML/PDF + normalized text).
STORAGE_BUCKET=""

# Firebase auth domain.
FIREBASE_AUTH_DOMAIN=""

# ---------------------------------------------------------------------------
# FRONTEND (browser bundle) — Vite build-time configuration
# ---------------------------------------------------------------------------
# The SPA is built by Vercel and must point at the SAME Firebase project as the
# backend for the environment it is deployed into. These are build-time
# variables: `vite build` inlines them, so a production build with any of them
# missing FAILS (see src/lib/firebase.ts — no silent fallback to the AI Studio
# applet project). Staging and production MUST use different values.
#
# Development (`vite dev`) ignores these and uses the local applet project.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Absolute API origin when the backend is not same-origin (Vercel -> Railway).
VITE_API_URL=""

# ---------------------------------------------------------------------------
# SSE STREAM TICKETS
# ---------------------------------------------------------------------------
# EventSource cannot send Authorization headers, so live progress uses a 60s
# single-use ticket minted over an authenticated request. Production defaults to
# the shared Firestore store (so replica A's ticket is consumable once by
# replica B). Override only for local testing:
#   memory    -> in-process (single replica, lost on restart)
#   firestore -> shared, transactional single-use
STREAM_TICKET_STORE=""

# Where the Gemini credential comes from (descriptive only; never the secret).
# e.g. "env:GEMINI_API_KEY" or "secret-manager:projects/x/secrets/gemini"
GEMINI_CREDENTIAL_SOURCE=""

# The production project id. When set, staging/development are forbidden from
# binding it — this is the guard against testing against production data.
PRODUCTION_PROJECT_ID=""

# ---------------------------------------------------------------------------
# DEPLOY TARGET: Vercel (frontend) + Railway (backend)
# ---------------------------------------------------------------------------
# The SPA (Vite build output) deploys to Vercel. The Express API (Docker
# image) deploys to Railway. Browsers call the API cross-origin, so the
# backend must know the frontend origin:
#
# FRONTEND_ORIGIN: comma-separated allowlist for CORS, e.g.
#   https://market-metrics.vercel.app
# Empty in dev = localhost origins are allowed; staging/production MUST set it.
FRONTEND_ORIGIN=""

# ADMIN_UIDS: comma-separated Firebase UIDs allowed to touch /admin/*,
# /system/*, /metrics, /errors, /backup, /restore. Empty = nobody (fail closed).
# Railway dashboard is the management surface: edit the variable, redeploy.
ADMIN_UIDS=""

# LOG_LEVEL: debug | info | warn | error (default: debug in dev, info in prod).
LOG_LEVEL=""

# Backing-store selectors. Defaults are single-replica safe.
#   memory     in-process (default)
#   firestore  atomic buckets (multi-replica, no Redis)
#   redis      NOT provisioned yet — selecting it fails closed with a clear
#              error (decision: Redis later, when replicas>1 justifies it).
RATE_LIMIT_STORE="memory"
COST_STORE="memory"
CACHE_STORE="memory"

